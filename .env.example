# Keep your key on this machine. Never commit .env.
DEEPSEEK_API_KEY=
# A dedicated file takes precedence over DEEPSEEK_API_KEY; keep it mode 0600.
# DEEPSEEK_API_KEY_FILE=~/.ssh/musicmap_trans
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_MAX_TOKENS=32768
DEEPSEEK_TIMEOUT_MS=600000
PORT=4173
